<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext only for loopback, for the mock server. Everything else stays HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- Debug builds only: also trust a user-installed CA, for the owner's test against the real server over USB with Caddy's internal certificate (D-024). Release trusts system CAs only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
